{"id":"ray-tracer-r1","title":"Ray tracer","subtitle":"revision 1","author":null,"source":"artifacts/ray-tracer-before.asm","profile":"bootstrap-1","format":"RGB888","engines":["CPU"],"payloadBytes":1420,"cartridgeBytes":1452,"cartridgeSha256":"0a53e328d435d53bdb99c53c7946ec0e89f243749e19fe793088094956f690df","rgbaSha256":"cf33a15155680b2dbfe6f38d10352fa4940176d566d754f5174b61f609d20e2b","wasmSha256":"8fbac8f8ef7771c0522d05b2d928c760b52075b21c513f9546617184dded0780","frames":480,"seconds":8,"firstVisibleFrame":2,"halted":true,"gpuDispatches":0,"gpuBudgetPercent":null,"spuBlocks":0,"audioPeak":0,"lines":401,"instructions":321,"notes":["Three spheres, directional shadows, and a reflective checkerboard.","Every RGB888 pixel is ray traced by DB32 instructions. No image assets.","Camera at (0,0,0), ray D=(x-80,40-y,128), floor at y=-36.","Intersections solve A*t*t - 2*B*t + C = 0; t uses 12 fraction bits.","Reflections intersect spheres mirrored across the floor (one bounce)."],"excerpt":".equ FB, 0x10000\n.equ VIDEO, 0xf5000\n.equ SCRATCH, 0x2f000\n.entry start\nstart:\n    li r15, SCRATCH\n    li r1, FB\n    li r7, VIDEO\n    sw r1, 0(r7)\n    addi r8, r0, 480\n    sw r8, 4(r7)\n    addi r8, r0, 4\n    sw r8, 8(r7)\n    addi r8, r0, 1\n    sw r8, 16(r7)\n    sw r8, 20(r7)          ; show the image as rays are computed\n    mov r3, r0\nrow:","description":null,"scenes":null,"poster":"ray-tracer-r1.png","gif":"ray-tracer-r1.gif","gifFps":20,"gifFrames":80,"keyframes":[{"file":"ray-tracer-r1-k00.png","frame":6},{"file":"ray-tracer-r1-k01.png","frame":72},{"file":"ray-tracer-r1-k02.png","frame":144},{"file":"ray-tracer-r1-k03.png","frame":210},{"file":"ray-tracer-r1-k04.png","frame":276},{"file":"ray-tracer-r1-k05.png","frame":342},{"file":"ray-tracer-r1-k06.png","frame":414},{"file":"ray-tracer-r1-k07.png","frame":480}],"bytes":"ray-tracer-r1-bytes.png","payloadHex":"","audio":null}