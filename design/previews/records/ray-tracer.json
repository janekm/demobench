{"id":"ray-tracer","title":"Ray tracer","subtitle":"spheres & reflections","author":null,"source":"examples/ray-tracer.asm","profile":"bootstrap-1","format":"RGB888","engines":["CPU"],"payloadBytes":2072,"cartridgeBytes":2104,"cartridgeSha256":"feb626440868a223643a33e6e5d64c68915e0806d499bed3ef32f275f5df6c27","rgbaSha256":"e8d1dde2d65785baf1e41ca0fa2eaee571e740fff31fc4fdeaec56051fbf0049","wasmSha256":"8fbac8f8ef7771c0522d05b2d928c760b52075b21c513f9546617184dded0780","frames":480,"seconds":8,"firstVisibleFrame":2,"halted":true,"gpuDispatches":0,"gpuBudgetPercent":null,"spuBlocks":0,"audioPeak":0,"lines":565,"instructions":491,"notes":["CPU Whitted ray tracer: three reflective spheres and a checkerboard.","Three surface hits per pixel; every hit casts a finite ray to a point light.","Positions/distances use Q4; unit directions/normals Q10; colours/weights Q8.","Integer normalization, square root and division run on the guest CPU.","r15 is scratch RAM; no image assets, host shading, or GPU instructions."],"excerpt":".equ FB, 0x10000\n.equ VIDEO, 0xf5000\n.equ SCRATCH, 0x2f000\n.equ MAX_HITS, 3\n.equ SHADOWS, 1\n.entry start\nstart:\n    li r15, SCRATCH\n    li r1, FB\n    sw r1, 48(r15)\n    li r7, VIDEO\n    sw r1, 0(r7)\n    addi r8, r0, 480\n    sw r8, 4(r7)\n    addi r8, r0, 4\n    sw r8, 8(r7)\n    addi r8, r0, 1\n    sw r8, 16(r7)","description":null,"scenes":null,"poster":"ray-tracer.png","gif":"ray-tracer.gif","gifFps":20,"gifFrames":80,"keyframes":[{"file":"ray-tracer-k00.png","frame":6},{"file":"ray-tracer-k01.png","frame":72},{"file":"ray-tracer-k02.png","frame":144},{"file":"ray-tracer-k03.png","frame":210},{"file":"ray-tracer-k04.png","frame":276},{"file":"ray-tracer-k05.png","frame":342},{"file":"ray-tracer-k06.png","frame":414},{"file":"ray-tracer-k07.png","frame":480}],"bytes":"ray-tracer-bytes.png","payloadHex":"","audio":null}